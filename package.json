{
  "name": "swiftui-for-web",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "A zero-dependency declarative UI framework that brings Apple's SwiftUI paradigm to web development.",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "import": "./src/core.js",
      "default": "./src/core.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js",
      "default": "./src/server.js"
    },
    "./charts": {
      "types": "./src/Charts/index.d.ts",
      "import": "./src/Charts/index.js",
      "default": "./src/Charts/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./internal/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node run-tests.js && node scripts/run-node-suites.js && node scripts/check-package.js && node scripts/build-tests.js",
    "validate": "npm test && npm run test:browser && npm run build && npm run size",
    "test:browser": "node scripts/run-browser-tests.js",
    "test:package": "node scripts/check-package.js",
    "test:build": "node scripts/build-tests.js",
    "build": "node scripts/build.js",
    "size": "node scripts/size.js dist --budget-gzip-kb 120",
    "serve": "python3 -m http.server 8000 || python -m http.server 8000",
    "example:airbnb": "echo 'Open http://localhost:8000/Examples/Airbnb/' && npm run serve",
    "example:counter": "echo 'Open http://localhost:8000/Examples/Counter/' && npm run serve",
    "example:todo": "echo 'Open http://localhost:8000/Examples/TodoApp/' && npm run serve",
    "example:charts": "echo 'Open http://localhost:8000/Examples/Charts/' && npm run serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnBaek/SwiftUI-For-Web.git"
  },
  "homepage": "https://github.com/ShawnBaek/SwiftUI-For-Web#readme",
  "bugs": {
    "url": "https://github.com/ShawnBaek/SwiftUI-For-Web/issues"
  },
  "keywords": [
    "swiftui",
    "ui-framework",
    "declarative",
    "web",
    "javascript",
    "frontend",
    "mvvm",
    "reactive",
    "components",
    "no-dependencies",
    "zero-dependencies",
    "vanilla-js",
    "charts",
    "swift-charts",
    "data-visualization"
  ],
  "author": "Shawn Baek",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "sideEffects": [
    "./src/runtime.js",
    "./src/View/Control/Picker.js",
    "./src/View/Navigation/TabView.js",
    "./src/styles/*.css"
  ],
  "directories": {
    "doc": "docs"
  }
}
